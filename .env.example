OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-nano
# Firebase browser configuration (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# RevenueCat Web Billing public SDK key and package identifiers
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
NEXT_PUBLIC_REVENUECAT_MONTHLY_PACKAGE_ID=$rc_monthly
NEXT_PUBLIC_REVENUECAT_SIX_MONTH_PACKAGE_ID=six_month
