OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-nano

# Supabase (publishable values are safe in the browser; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Billing. Only the publishable key may be exposed to browser code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRODUCT_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_SIX_MONTH_PRODUCT_ID=
STRIPE_SIX_MONTH_PRICE_ID=
STRIPE_PROMOTIONAL_SIX_MONTH_DISCOUNT_PRODUCT_ID=
STRIPE_PROMOTIONAL_SIX_MONTH_DISCOUNT_PRICE_ID=
STRIPE_PROMOTIONAL_SIX_MONTH_RETENTION_PRODUCT_ID=
STRIPE_PROMOTIONAL_SIX_MONTH_RETENTION_PRICE_ID=
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=
# RevenueCat: public Web SDK key; remaining values are server-only.
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
REVENUECAT_STRIPE_APP_PUBLIC_API_KEY=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PRO_ENTITLEMENT_ID=pro
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
