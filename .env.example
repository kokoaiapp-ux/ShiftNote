OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-nano
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (publishable values are safe in the browser; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Billing and Customer Portal (all values below are server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_SIX_MONTH_PRICE_ID=
STRIPE_PROMOTIONAL_SIX_MONTH_PRICE_ID=

# RevenueCat identifies customers by the Supabase user UUID.
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
REVENUECAT_STRIPE_PUBLIC_API_KEY=
REVENUECAT_PRO_ENTITLEMENT_ID=pro
REVENUECAT_WEBHOOK_AUTH=