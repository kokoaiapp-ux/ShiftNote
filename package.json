{
    "name": "shiftnote-assistant",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
        "build": "npm run security:secrets && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && npm run security:secrets -- --bundles",
        "build:vercel": "npm run env:production && npm run security:secrets && cross-env NITRO_PRESET=vercel vite build && npm run security:secrets -- --bundles",
        "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
        "test": "npm run build && node --test tests/rendered-html.test.mjs",
        "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel",
        "db:generate": "drizzle-kit generate",
        "test:db": "node scripts/test-supabase-schema.mjs",
        "test:tiktok": "node scripts/test-tiktok-events.mjs",
        "test:db:live": "node scripts/test-supabase-live.mjs",
        "security:secrets": "node scripts/verify-secret-boundaries.mjs",
        "env:production": "node scripts/verify-production-env.mjs",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ai-sdk/openai": "^4.0.23",
        "@ai-sdk/react": "^4.0.44",
        "@supabase/ssr": "^0.12.4",
        "@supabase/supabase-js": "^2.112.0",
        "ai": "^7.0.41",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "0.45.2",
        "lucide-react": "^1.27.0",
        "next": "16.2.6",
        "nitro": "^3.0.260610-beta",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "stripe": "^22.4.0",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.37.1",
        "@cloudflare/workers-types": "^4.20260702.1",
        "@electric-sql/pglite": "^0.5.4",
        "@tailwindcss/postcss": "4.2.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "22.19.19",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "@vitejs/plugin-rsc": "0.5.26",
        "cross-env": "^10.1.0",
        "drizzle-kit": "0.31.10",
        "eslint": "9.39.4",
        "eslint-config-next": "16.2.6",
        "react-server-dom-webpack": "19.2.6",
        "supabase": "^2.111.0",
        "tailwindcss": "4.2.1",
        "typescript": "5.9.3",
        "vinext": "0.0.50",
        "vite": "8.0.13",
        "wrangler": "4.92.0"
    },
    "type": "module"
}
