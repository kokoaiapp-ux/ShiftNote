# Copy this file to .env.local and replace each placeholder locally.
# Never commit .env.local or paste its secrets into source code.

# Google Analytics 4 (safe browser Measurement ID; loaded only in production)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# TikTok Pixel and server-side Events API
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your_tiktok_pixel_id
TIKTOK_EVENTS_API_TOKEN=your_tiktok_events_api_token
# Optional during TikTok Events Manager Test Events verification; remove after testing.
TIKTOK_TEST_EVENT_CODE=

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=your_openai_model

# Supabase Auth (publishable browser configuration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only: required for permanent account deletion
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-only: required to cancel renewal before deleting subscribed accounts
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_MONTHLY_PRODUCT_ID=prod_replace_me
STRIPE_MONTHLY_PRICE_ID=price_replace_me
STRIPE_SIX_MONTH_PRODUCT_ID=prod_replace_me
STRIPE_SIX_MONTH_PRICE_ID=price_replace_me
STRIPE_PROMOTIONAL_SIX_MONTH_DISCOUNT_PRODUCT_ID=prod_replace_me
STRIPE_PROMOTIONAL_SIX_MONTH_DISCOUNT_PRICE_ID=price_replace_me
STRIPE_PROMOTIONAL_SIX_MONTH_RETENTION_PRODUCT_ID=prod_replace_me
STRIPE_PROMOTIONAL_SIX_MONTH_RETENTION_PRICE_ID=price_replace_me
# Optional: use a specific activated Customer Portal configuration.
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=
# Local migration tooling only. Do not expose these with NEXT_PUBLIC_ prefixes.
# Create the access token at https://supabase.com/dashboard/account/tokens.
# Find the project reference in Project Settings > General.
# Find/reset the database password in Project Settings > Database.
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token
SUPABASE_PROJECT_REF=your_project_reference
SUPABASE_DB_PASSWORD=your_database_password

# RevenueCat: public Web SDK key; remaining values are server-only.
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
REVENUECAT_STRIPE_APP_PUBLIC_API_KEY=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PRO_ENTITLEMENT_ID=pro
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
